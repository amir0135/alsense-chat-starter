{
  "additionalProperties": false,
  "description": "The service's confirmation. Only after this may the assistant say something was created or scheduled.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "report",
        "scheduled_report",
        "ticket"
      ],
      "title": "Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "scheduled",
        "received"
      ],
      "title": "Status",
      "type": "string"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "next_run": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Run"
    }
  },
  "required": [
    "id",
    "kind",
    "status",
    "url",
    "synthetic"
  ],
  "title": "Submission",
  "type": "object"
