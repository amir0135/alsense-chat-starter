# Allowlist: only what the image needs enters the Docker build context.
*
!pyproject.toml
!uv.lock
!.python-version
!src/
!scripts/

# Never, even inside allowed folders: customer material, secrets, local data and caches.
**/*.local.yaml
**/*.local.*
**/.env
**/.env.*
**/.azure
**/*.sqlite3*
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
