# Alsense chat starter configuration. Copy it first:   cp .env.example .env
#
# These defaults run the synthetic demo: no secrets, no Azure, no connection to Alsense.
# .env is ignored by Git and Docker. Never commit it.
#
# Each setting is marked:
#   [every mode]  read in every mode; the value shown is a safe default
#   [synthetic]   safe synthetic default; change it to trim the demo or rehearse failures
#   [azure]       only for AGENT_MODE=foundry
#   [secret]      never safe to commit or to paste into chats, tickets or prompts
# Check your setup at any time with: uv run python scripts/doctor.py

# ---- Mode ---------------------------------------------------------------------------------------
# [every mode] demo = scripted assistant, no AI model. foundry = your Azure AI Foundry model.
AGENT_MODE=demo
# [every mode] synthetic = synthetic APIs. alsense = real adapters (placeholders: startup refuses it).
DATA_SOURCE=synthetic
# [every mode] Port for scripts/dev.py start and Docker Compose: http://127.0.0.1:8001
APP_PORT=8001
# [every mode] DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# ---- Local data ---------------------------------------------------------------------------------
# [every mode] SQLite file for sessions, drafts and the audit trail. Docker Compose uses a named volume.
SESSION_DB=./data/sessions.sqlite3
# [synthetic] true deletes SESSION_DB at every start, for a clean demo each time.
RESET_DEMO_DATA_ON_START=false
# [every mode] How long a demo session stays signed in.
SESSION_TTL_SECONDS=3600

# ---- Demo sign-in -------------------------------------------------------------------------------
# [every mode] Synthetic identities (Alice, Bob, Carol). Startup refuses false until real sign-in exists.
DEMO_LOGIN=true
# [every mode] Backend kill switch for the chat.
CHAT_ENABLED=true
# [every mode] Hosted demo only. infra/deploy.sh sets it to true and generates the access code.
CLOUD_DEMO=false
# [secret] Generated by infra/deploy.sh for Azure. Never commit it or send it to the model.
# DEMO_ACCESS_CODE=

# ---- Features -----------------------------------------------------------------------------------
# [synthetic] Turn whole capabilities off for a shorter demo. The UI hides what is off.
ENABLE_REPORTS=true
ENABLE_TROUBLESHOOTING=true
ENABLE_SUPPORT_REQUESTS=true

# ---- Troubleshooting content --------------------------------------------------------------------
# [synthetic] Empty = the synthetic sample flows and scenarios shipped in src/alsense_chat/.
# Customer-provided flows belong in a *.local.yaml file, which Git, Docker and the export exclude.
# Example: FLOWS_FILE=./flows.local.yaml and SCENARIOS_FILE=./scenarios.local.yaml
FLOWS_FILE=
SCENARIOS_FILE=

# ---- Rehearse failures --------------------------------------------------------------------------
# [synthetic] Comma-separated fault switches applied to every session (scenarios add their own):
#   api_timeout, unauthenticated, site_forbidden, site_not_found, health_unavailable, health_stale,
#   knowledge_empty, report_processing, report_failed, support_unavailable, model_unavailable
SYNTHETIC_FAULTS=

# ---- Azure mode only (AGENT_MODE=foundry) --------------------------------------------------------
# [azure] Requires `az login`. Startup fails if either value is missing; it never falls back to the
# scripted assistant. Your messages and synthetic tool results go to your own Foundry project.
# FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# MODEL_DEPLOYMENT=gpt-5-mini
# [azure] Containers have no `az login`; use a service principal instead (read by azure-identity).
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# [azure] [secret]
# AZURE_CLIENT_SECRET=
# [azure] [secret] Optional Application Insights telemetry. Treat it like a credential.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Set automatically --------------------------------------------------------------------------
# The commit shown on /system. The Docker build sets it; locally Git is used.
# APP_COMMIT=

# ---- Behind a corporate package mirror ----------------------------------------------------------
# scripts/dev.py setup and docker compose build install the exact locked versions, hash-checked,
# from this index instead of PyPI. Leave it unset to use PyPI.
# UV_DEFAULT_INDEX=https://your-mirror.example/simple
