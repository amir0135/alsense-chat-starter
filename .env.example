# Synthetic local demo only. Never enable DEMO_LOGIN on a deployed application.
DEMO_LOGIN=true
CHAT_ENABLED=true
AGENT_MODE=demo
SESSION_DB=./sessions.sqlite3
SESSION_TTL_SECONDS=3600
CLOUD_DEMO=false
# Generated by infra/deploy.sh for Azure. Never commit or send to the model.
# DEMO_ACCESS_CODE=

# Optional real model, still using synthetic tools. Requires `az login`.
# This sends synthetic tool results and your messages to your own Foundry project.
# FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# MODEL_DEPLOYMENT=gpt-5-mini

# Real Alsense auth, APIs, Search, APIM and explicit Content Safety integration are NOT implemented.
# Startup refuses DEMO_LOGIN=false until a trusted authentication provider is wired.
