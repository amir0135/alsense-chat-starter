<mxfile host="app.diagrams.net" agent="drawio-mcp">
  <diagram id="architecture" name="Architecture"><mxGraphModel dx="1960" dy="1130" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1150" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Alsense chat starter · architecture" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Backend-owned tools over synthetic APIs. The model never receives user credentials, and nothing is sent to Alsense." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=14;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1300" height="26" as="geometry"/></mxCell><mxCell id="azure" value="Microsoft Azure · optional, not used by the local demo" style="swimlane;startSize=30;collapsible=0;rounded=1;arcSize=3;html=1;fontStyle=1;fontSize=14;align=left;spacingLeft=14;fontColor=#1F2937;strokeWidth=1.5;fillColor=#E1D5E7;strokeColor=#9673A6;swimlaneFillColor=#FBF8FD;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="1200" height="140" as="geometry"/></mxCell><mxCell id="foundry" value="&lt;b&gt;Microsoft Foundry&lt;/b&gt;&lt;br&gt;Responses API&lt;br&gt;your model deployment&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;store=false · function calling&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1F2937;spacing=6;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#9673A6;" vertex="1" parent="azure"><mxGeometry x="30" y="40" width="190" height="86" as="geometry"/></mxCell><mxCell id="gateway" value="&lt;b&gt;APIM / AI gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;future&lt;/i&gt; · on the backend&lt;br&gt;to model path" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1F2937;spacing=6;strokeWidth=1.5;fillColor=#FAFAFA;strokeColor=#9E9E9E;dashed=1;dashPattern=6 4;fontColor=#6B7280;" vertex="1" parent="azure"><mxGeometry x="320" y="40" width="190" height="86" as="geometry"/></mxCell><mxCell id="hosting" value="&lt;b&gt;Hosted demo&lt;/b&gt;&lt;br&gt;Container Apps · ACR&lt;br&gt;Key Vault · managed identity&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;infra/*.bicep · access code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1F2937;spacing=6;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#9673A6;" vertex="1" parent="azure"><mxGeometry x="610" y="40" width="210" height="86" as="geometry"/></mxCell><mxCell id="insights" value="&lt;b&gt;Application Insights&lt;/b&gt;&lt;br&gt;request telemetry&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;hosted demo · no message capture&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1F2937;spacing=6;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#9673A6;" vertex="1" parent="azure"><mxGeometry x="910" y="40" width="260" height="86" as="geometry"/></mxCell><mxCell id="user" value="Internal user" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#DAE8FC;strokeColor=#1F2937;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="520" width="50" height="90" as="geometry"/></mxCell><mxCell id="browser" value="Browser" style="swimlane;startSize=30;collapsible=0;rounded=1;arcSize=3;html=1;fontStyle=1;fontSize=14;align=left;spacingLeft=14;fontColor=#1F2937;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#F5F9FF;" vertex="1" parent="1"><mxGeometry x="140" y="380" width="250" height="350" as="geometry"/></mxCell><mxCell id="widget" value="&lt;b&gt;Chat widget&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;static/index.html + widget.js&lt;/font&gt;&lt;br&gt;&lt;br&gt;• suggested questions&lt;br&gt;• cited source excerpts&lt;br&gt;• report and support drafts&lt;br&gt;• separate &lt;b&gt;Submit&lt;/b&gt; button&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;same-origin · embeddable&lt;br&gt;token kept in memory only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1F2937;spacing=6;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#6C8EBF;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="browser"><mxGeometry x="25" y="45" width="200" height="280" as="geometry"/></mxCell><mxCell id="backend" value="Chat backend · FastAPI (uvicorn :8001)" style="swimlane;startSize=30;collapsible=0;rounded=1;arcSize=3;html=1;fontStyle=1;fontSize=14;align=left;spacingLeft=14;fontColor=#1F2937;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#F6FBF5;" vertex="1" parent="1"><mxGeometry x="460" y="340" width="1080" height="560" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;Auth gate&lt;/b&gt;&lt;br&gt;bearer session token&lt;br&gt;SHA-256 hash lookup&lt;br&gt;expiry · feature flag&lt;br&gt;internal-user check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1F2937;spacing=6;strokeWidth=1.5;fillColor=#FDF3F3;strokeColor=#B85450;" vertex="1" parent="backend"><mxGeometry x="30" y="60" width="200" height="130" as="geometry"/></mxCell><mxCell id="run" value="&lt;b&gt;Run loop&lt;/b&gt;&lt;br&gt;demo_run · deterministic&lt;br&gt;FoundryRunner · optional&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;backend runs every tool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1F2937;spacing=6;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="backend"><mxGeometry x="330" y="60" width="190" height="130" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;Curated tools (6)&lt;/b&gt;&lt;br&gt;search_docs · resolve_sites&lt;br&gt;list_report_types&lt;br&gt;get_report_status&lt;br&gt;prepare_report&lt;br&gt;prepare_support_ticket&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;typed schemas · site checks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1F2937;spacing=6;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="backend"><mxGeometry x="620" y="60" width="190" height="130" as="geometry"/></mxCell><mxCell id="adapter" value="&lt;b&gt;AlsenseSource&lt;/b&gt;&lt;br&gt;adapter boundary&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;typed contracts&lt;br&gt;tenant and site&lt;br&gt;filtering&lt;br&gt;&lt;br&gt;credentials stay&lt;br&gt;in adapter context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1F2937;spacing=6;strokeWidth=1.5;fillColor=#FFF8E1;strokeColor=#D6B656;" vertex="1" parent="backend"><mxGeometry x="910" y="60" width="140" height="470" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;Reply guard&lt;/b&gt;&lt;br&gt;strict JSON · known sources&lt;br&gt;numbers match evidence&lt;br&gt;no raw links or internal ids&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;1 repair, then abstain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1F2937;spacing=6;strokeWidth=1.5;fillColor=#FDF3F3;strokeColor=#B85450;" vertex="1" parent="backend"><mxGeometry x="330" y="250" width="190" height="120" as="geometry"/></mxCell><mxCell id="sqlite" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;sessions · token hashes&lt;br&gt;turns · drafts · results&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;unanswered categories&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="backend"><mxGeometry x="620" y="250" width="190" height="120" as="geometry"/></mxCell><mxCell id="confirm" value="&lt;b&gt;Confirmation endpoint&lt;/b&gt;&lt;br&gt;POST /api/actions/{id}/submit&